# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.


#  For the portal
exec systemctl --user import-environment

#include /etc/sway/config.d/*

include /etc/sway/config-vars.d/*

### Variables

set $PATH $HOME/bin:/usr/local/bin:/usr/bin:/usr/sbin:/usr/local/games:/usr/games
set $TERMINAL foot --log-level=error
set $CARGO_PATH $HOME/.local/share/cargo/bin
set $background /home/davide/.local/share/wallpapers/night-sky.jpg
#set $lockscreen swaylock -e -F -i $background -k
set $lockscreen gtklock -T 5
set $term foot
set $menu tofi-run | xargs swaymsg exec exec --
set $dmenu tofi-drun | xargs swaymsg exec exec --

# Keys variables 
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l



### Inputs & Outputs

output HDMI-A-1 bg $background fill resolution 3840x2160 scale 2 position 0,0
#output HDMI-A-1 bg $background fill resolution 1920x1080 position 0,0
output eDP-1 bg $background fill resolution 1920x1080 position 0,1080
#output * bg #000000 solid_color
output * bg $background fill


input type:keyboard {
      xkb_layout it
}

input "1267:12351:ELAN0511:01_04F3:303F_Touchpad" {
    dwt enabled
#    tap enabled
    middle_emulation enabled
    click_method clickfinger
    clickfinger_button_map lrm
}



### Status Bar
bar swaybar_command /home/davide/bin/waybar


### Key bindings

# Launch programs
bindsym $mod+Return exec exec $term
bindsym $mod+m exec $menu
bindsym $mod+Shift+m exec $dmenu

#Reload configuration
bindsym $mod+Shift+c reload


### Workspaces and windows management

bindsym Alt+F1 layout toggle tabbed splith splitv
bindsym Alt+F2 focus prev
bindsym Alt+F3 floating toggle
bindsym Mod1+F4 kill


# Resizing
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym Alt+F6 mode "resize"

# Move windows in the workspace
bindsym $mod+a move left
bindsym $mod+s move down
bindsym $mod+w move up
bindsym $mod+d move right

# Scratchpad:
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Select window
bindsym Alt+Tab exec $HOME/quasi_sensato/sway-windows/sway-windows


# Create workspace and move current window
bindsym $mod+Shift+plus exec $CARGO_PATH/sway-workspace-manager move-to-new next

# Move window to different workspace or output
#bindsym $mod+Shift+d move to workspace prev_on_output
#bindsym $mod+Shift+a exec $CARGO_PATH/sway-workspace-manager move next --cycle
bindsym $mod+Shift+d exec $CARGO_PATH/sway-workspace-manager move next --cycle
bindsym $mod+Shift+a exec $CARGO_PATH/sway-workspace-manager move prev --cycle
bindsym $mod+Shift+w move to output up
bindsym $mod+Shift+s move to output down



# Workspaces

# Create new workspace
bindsym $mod+plus exec $CARGO_PATH/sway-workspace-manager create next

# Switch workspace
bindsym $mod+Left workspace prev_on_output
bindsym $mod+Right workspace next_on_output

# Change workspace output
bindsym $mod+Shift+Up move workspace output up
bindsym $mod+Shift+Down move workspace output down

# Swap workspaces
bindsym $mod+Shift+Left exec $CARGO_PATH/swaymsg_workspace swap_with_prev
bindsym $mod+Shift+Right exec $CARGO_PATH/swaymsg_workspace swap_with_next


# Moving the cursor
bindsym $mod+Shift+Ctrl+Left seat - cursor move -19 0
bindsym $mod+Shift+Ctrl+Right seat - cursor move +19 0
bindsym $mod+Shift+Ctrl+Up seat - cursor move 0 -11
bindsym $mod+Shift+Ctrl+Down seat - cursor move 0 +11



#
# Utilities:
#

# Special keys to adjust volume via PulseAudio
bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

# Special keys to adjust brightness via brightnessctl
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+

# Play/pause music
bindsym $mod+Space exec playerctl play-pause

# Take a screenshot
bindsym Print exec grim

# Print a QR codes from clipboard
bindsym $mod+Shift+v exec "wl-paste | qrencode -s 30 -o - | imv-wayland -w QRcode -"
for_window [title="QRcode"] floating enable

# Load password to clipboard
bindsym $mod+p exec exec $HOME/bin/passmenu
bindsym $mod+o exec exec $HOME/bin/passmenu --otp

# Show system information
bindsym $mod+b exec notify-send -t 2000 "`acpi -e`"
bindsym $mod+t exec notify-send -t 2000 "`date`"
bindsym $mod+u exec notify-send -t 2000 "`free -; swapon; zramctl`"

# Quit dialogue
bindsym $mod+Escape exec pidof wlogout > /dev/null && loginctl lock-session && killall wlogout || wlogout


