### Services

# Desktop utilities
exec exec udiskie -s
exec exec nm-applet
exec exec mako
# exec exec bash -c "acpi_listen | grep --line-buffered \"^jack/headphone HEADPHONE unplug$\" | while read; do playerctl pause; done"
exec exec swayidle lock "$lockscreen" before-sleep "$lockscreen"


# Improve behaviour
exec exec bash -c "killall autotiling >& /dev/null; exec autotiling"
exec exec bash -c "exec $HOME/bin/edge -V -l 1"

exec exec bash -c "killall urgent_desktop.py >& /dev/null; exec $HOME/python/i3ipc-python/examples/urgent_desktop.py"
for_window [urgent="last" app_id=".*((?!Evince).)*"] focus

# notify Xwayland
exec exec bash -c "killall xwayland_notify.py >& /dev/null; exec $HOME/python/i3ipc-python/examples/xwayland_notify.py -s 'New X11 app: {psname}' -b 'name: {name}, pid: {pid}' -n"





### Per-window policies

#for_window [title="^.*" tiling] border pixel 5
#for_window [title="^.*"] title_format "<b>%title</b> (%app_id)"

# Fucking Thunderbird
for_window [app_id="thunderbird"] floating enable
for_window [title=".*Mozilla Thunderbird" app_id="thunderbird"] floating disable
#for_window [title="Write: .*" app_id="thunderbird"] floating enable
#for_window [title="New Event:.*" app_id="thunderbird"] floating enable
#for_window [title=".*[pP]assword.*" app_id="thunderbird"] floating enable
#for_window [title=".*[Cc]redentials.*" app_id="thunderbird"] floating enable
#for_window [title="Write: .*"] floating enable
#for_window [title="Write: .* - Thunderbird"] border normal 3

#for_window [class=".*JabRef.*" title="Import"] floating enable

for_window [title="Firefox - Choose User Profile"] floating enable
for_window [title="Mozilla Firefox"] layout tabbed




focus_follows_mouse always


## colors
include translucent-windows
#client.focused #bc0859 #bc0859   #ffffff
#client.unfocused #191970 #191970   #ffffff

# Aestethics
font monospace 12
seat seat0 xcursor_theme Adwaita 34
hide_edge_borders both
default_border  pixel 7

# Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal


